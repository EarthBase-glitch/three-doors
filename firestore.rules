rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Door choices — no real auth backs these, so both directions stay open,
    // matching the "handle + passphrase" identity model in the app.
    match /votes/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Sign-in records (display name + hashed passphrase). Not real auth —
    // see the in-app disclaimer. A name can be claimed exactly once: create
    // is open, but update/delete are blocked entirely, so a name already
    // taken can never be overwritten — including by two people racing to
    // create the same name at once. Firestore treats a second write to the
    // same path as "update" once the first has landed, so this closes the
    // race at the database level, not just in the app's own pre-check.
    match /accounts/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /characters/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Community lore submissions. Anyone can propose one (status forced to
    // "pending" and lightly validated); only an authenticated admin
    // (Firebase Authentication -> Email/Password, set up in the console)
    // can approve, reject, or edit one. Only approved entries are publicly
    // readable — pending/rejected ones are visible to the signed-in admin
    // only, via admin.html.
    match /submissions/{id} {
      allow read: if resource.data.status == 'approved' || request.auth != null;
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.realm in ['heaven', 'earth', 'hell']
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 600;
      allow update, delete: if request.auth != null;
    }
  }
}
