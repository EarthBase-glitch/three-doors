rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Door choices — no real auth backs these, so both directions stay open,
    // matching the "handle + passphrase" identity model in the app.
    match /votes/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Sign-in records (display name + hashed passphrase). Not real auth —
    // see the in-app disclaimer. A name can be claimed exactly once: create
    // is open, but update/delete are blocked entirely, so a name already
    // taken can never be overwritten — including by two people racing to
    // create the same name at once. Firestore treats a second write to the
    // same path as "update" once the first has landed, so this closes the
    // race at the database level, not just in the app's own pre-check.
    match /accounts/{id} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /characters/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Daily task checklists + streaks. Same identity model as the above —
    // not gated to "your own" account at the database level, since there's
    // no real per-account auth to check against.
    match /dailytasks/{id} {
      allow read: if true;
      allow write: if true;
    }

    // Community lore submissions. Anyone can propose one (status forced to
    // "pending" and lightly validated); only an authenticated admin
    // (Firebase Authentication -> Email/Password, set up in the console)
    // can approve, reject, or edit one. Only approved entries are publicly
    // readable — pending/rejected ones are visible to the signed-in admin
    // only, via admin.html.
    match /submissions/{id} {
      allow read: if resource.data.status == 'approved' || request.auth != null;
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.realm in ['heaven', 'earth', 'hell']
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 600;
      allow update, delete: if request.auth != null;
    }

    // Contact-the-creator messages from the bottom-right form on the
    // character page. Anyone can send one (a validly-formatted email is
    // required, matching the in-app form); only the authenticated admin
    // can read or clear them, via admin.html — never shown to other
    // visitors.
    match /feedback/{id} {
      allow read, update, delete: if request.auth != null;
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 800
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$');
    }

    // Standalone mailing-list-style record of every email collected from
    // the feedback form, keyed by the email address itself so resending
    // updates one record instead of duplicating. Same access shape as
    // feedback: anyone can add themselves, only the admin can read the
    // list back (via admin.html) or remove an entry.
    match /emails/{id} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.resource.data.email is string
                    && request.resource.data.email.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$');
    }

    // Raw page-view counter — one aggregate document per day (id is the
    // date), incremented on every load of index.html regardless of
    // sign-in. Anyone can write (every visitor increments it before they
    // may have an account); only the admin can read the numbers back, via
    // stats.html.
    match /pageviews/{id} {
      allow read: if request.auth != null;
      allow write: if true;
    }

    // Donation totals, one aggregate doc per account (id = accountId).
    // Public read — this is the visible "who supported the world, and how
    // much" leaderboard. Writes are blocked for every client entirely:
    // only the stripeWebhook Cloud Function writes here, using the Admin
    // SDK, which bypasses these rules by design. Nobody — not even a
    // signed-in visitor — can write or fake a donation record directly.
    match /donations/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Private billing record, one per account (id = accountId) —
    // { stripeCustomerId }. Never exposed to any client, including the
    // signed-in owner of the account: only the stripeWebhook and
    // createPortalSession Cloud Functions touch this, via the Admin SDK,
    // which bypasses these rules by design.
    match /billing/{id} {
      allow read: if false;
      allow write: if false;
    }
  }
}
